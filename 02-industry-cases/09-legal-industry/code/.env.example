# === LLM endpoint (OpenAI 协议兼容)===
# 推荐:livetoken — 详见 ../../../docs/livetoken.md
LLM_API_BASE=https://livetoken.top
LLM_API_KEY=sk-xxxxx
LLM_MODEL=claude-sonnet-4-5

# === 律所信息(用于签字栏)===
LAW_FIRM_NAME=示例律师事务所
LAW_FIRM_LICENSE=

# === 法律数据库(占位 · 接入需付费 API)===
# 北大法宝 / 威科先行 / 国家法律法规数据库
PKULAW_API_KEY=
WESTLAW_API_KEY=

# === Embedding(本地 · 用于类案检索)===
EMBEDDING_MODEL=BAAI/bge-m3

# === PII 脱敏 ===
PII_REDACT_ENABLED=true
