# === LLM endpoint (OpenAI 协议兼容)===
# 推荐:livetoken — 详见 ../../../docs/livetoken.md
LLM_API_BASE=https://livetoken.top
LLM_API_KEY=sk-xxxxx
LLM_MODEL=claude-sonnet-4-5

# === 医疗机构信息(医师签字栏)===
HOSPITAL_NAME=示例医院
DEPARTMENT=示例科室
DOCTOR_NAME=示例医师
DOCTOR_LICENSE=1100000000000000

# === 医疗合规(三重保险)===
PII_REDACT_ENABLED=true              # 患者 PII 必脱敏
EMERGENCY_INTERCEPT_ENABLED=true     # 急救关键词熔断
DOCTOR_REVIEW_REQUIRED=true          # 100% 医师二审
DRUG_DB_VERIFY_ENABLED=true          # 用药接药品数据库

# === 急救电话 ===
EMERGENCY_PHONE=120
POISON_HOTLINE=010-83132345
MENTAL_HOTLINE=400-161-9995
