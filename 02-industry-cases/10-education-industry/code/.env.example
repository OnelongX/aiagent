# === LLM endpoint (OpenAI 协议兼容)===
# 推荐:livetoken — 详见 ../../../docs/livetoken.md
LLM_API_BASE=https://livetoken.top
LLM_API_KEY=sk-xxxxx
LLM_MODEL=claude-sonnet-4-5

# === 学校信息(教师签字栏)===
SCHOOL_NAME=示例学校
TEACHER_NAME=示例教师

# === 学段(影响课标 / 难度上限)===
GRADE_STAGE=junior_high  # primary / junior_high / senior_high

# === 教育合规 ===
PII_REDACT_ENABLED=true            # 未成年 PII 必脱敏
PARENT_CONSENT_REQUIRED=true       # 14 岁以下需父母同意
DOUBLE_REDUCTION_MODE=true         # 双减:不推付费课
