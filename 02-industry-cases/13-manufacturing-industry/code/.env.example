# === LLM endpoint (OpenAI 协议兼容)===
# 推荐:livetoken — 详见 ../../../docs/livetoken.md
# ⚠️ 涉及工艺机密的工厂强烈建议私有部署 LLM(本地 / 内网)
LLM_API_BASE=https://livetoken.top
LLM_API_KEY=sk-xxxxx
LLM_MODEL=claude-sonnet-4-5

# === 工厂信息(工艺签字栏)===
FACTORY_NAME=示例工厂
WORKSHOP=示例车间
LINE_CODE=L01
PROCESS_ENGINEER=示例工艺工程师

# === 制造合规(五重保险)===
PII_REDACT_ENABLED=true
PROCESS_BOUNDARY_ENFORCED=true     # 工艺参数物理边界硬约束
QC_DOUBLE_CHECK_REQUIRED=true      # 质检 AI 必须 QC 二审
MES_READONLY_MODE=true             # MES 只读 · 写操作必须人工
RECIPE_SECRET_MASK=true            # 配方机密字段脱敏后再进 LLM

# === 行级权限 ===
USER_WORKSHOP=*                    # * 全部 / WS-A / WS-B / WS-C / WS-D

# === 应急联系 ===
SAFETY_HOTLINE=119
ESHS_HOTLINE=厂内 EHS 分机 8888
