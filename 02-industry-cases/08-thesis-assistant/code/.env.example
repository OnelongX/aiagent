# === LLM endpoint (OpenAI 协议兼容)===
# 推荐:livetoken — 一个 base_url 跑 GPT-5/Claude/Gemini/DeepSeek
# 详情见 ../../../docs/livetoken.md

LLM_API_BASE=https://livetoken.top
LLM_API_KEY=sk-xxxxx
LLM_MODEL=claude-sonnet-4-5

# === 学术 API ===
# arXiv / Crossref / OpenAlex 都是公开 API,无需 key
# Semantic Scholar 可选 key(免费,限速更宽松)
SEMANTIC_SCHOLAR_API_KEY=

# === Embedding (本地 · 用于相似度检测)===
EMBEDDING_MODEL=BAAI/bge-m3
